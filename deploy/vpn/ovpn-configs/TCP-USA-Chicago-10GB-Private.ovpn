setenv FORWARD_COMPATIBLE 1
setenv UV_SERVERID 1404
client
dev tun
proto tcp
remote 204.188.233.68
port 443
nobind
persist-key
persist-tun
ns-cert-type server
tls-version-min 1.2 or-highest
key-direction 1
push-peer-info
cipher AES-256-CBC
data-ciphers AES-256-CBC
comp-lzo
verb 3
mute 20
reneg-sec 86400
mute-replay-warnings
max-routes 1000
block-outside-dns
